# Copy this file to .env locally. Never add actual keys to this template.
# Current Comtrade public-preview workflow needs no API key and does not load .env.
# Only `python -m market_compass.extract --execute` uses OPENAI_API_KEY.
# It reads the repository-root .env. The browser and comparison server do not.
# TAVILY_API_KEY is reserved and unused. Leave all template values empty.
OPENAI_API_KEY=
TAVILY_API_KEY=
